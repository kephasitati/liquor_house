# Liquor House Kenya storefront. Every PUBLIC_* var is baked in at BUILD time.
#
# Leave the key empty to run on the demo cellar (src/data/catalog.ts) with WhatsApp checkout.
# Set it to the shop's Medusa publishable key and the catalogue, basket and checkout all come
# from that sales channel instead.
PUBLIC_MEDUSA_URL=http://localhost:8082
PUBLIC_MEDUSA_KEY_LIQUORHOUSE=
PUBLIC_MEDUSA_REGION_ID=
PUBLIC_SITE_URL=https://liquorhouse.co.ke
