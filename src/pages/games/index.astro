---
import Base from "../../layouts/Base.astro";
import "../../styles/games.css";
import Icon from "../../components/Icon.astro";
import { img } from "../../lib/img";
import { GAMES, REWARD, type GameKind } from "../../data/games";

/**
 * Games night: the arcade. A hero of floating game cards that lean with the pointer, tonight's
 * pick (a different game each day), a ribbon of Sheng, filters by kind, and every game as a
 * card that tilts and catches the light.
 */
const KIND: Record<GameKind, string> = { quiz: "Maswali", party: "Party", skill: "Ujuzi" };
const counts = { quiz: 0, party: 0, skill: 0 } as Record<GameKind, number>;
GAMES.forEach((g) => counts[g.kind]++);

const day = Math.floor(Date.now() / 86_400_000);
const tonight = GAMES[day % GAMES.length];
const fan = ["history", "headsup", "memory", "wyr", "chora"].map((id) => GAMES.find((g) => g.id === id)!).filter(Boolean);
---
<Base title="Games night" crumbs={[{ name: "Games night", path: "/games" }]} image="/games/history.webp" description={`${GAMES.length} games from The Liquor House — Kenyan history, methali, Sheng, Kichwa Juu, Chora!, Bei Gani? and more. Play solo or in teams; score high and win ${REWARD.percent}% off.`}>
  <!-- ============================================================ HERO -->
  <section class="arcade">
    <div class="arcade-light" aria-hidden="true"></div>
    <div class="wrap arcade-grid">
      <div>
        <span class="kicker fade-up">Mchezo · Games night</span>
        <h1 class="display h1 arcade-title">
          <span class="hl"><span>Cheza,</span></span>
          <span class="hl"><span><em>shinda.</em></span></span>
        </h1>
        <p class="lede fade-up" style="animation-delay:.4s">Games za mbogi — trivia ya 254, methali, Sheng, Pictionary, Heads Up na zaidi. Solo or in teams with a turn clock that tells you when to pass the phone.</p>
        <div class="arcade-stats fade-up" style="animation-delay:.55s">
          <div><b>{GAMES.length}</b><span>games</span></div>
          <div><b>2–4</b><span>teams</span></div>
          <div><b>{REWARD.percent}%</b><span>off for a solo high score</span></div>
        </div>
        <a class="tonight fade-up" style="animation-delay:.7s" href={`/games/${tonight.id}`}>
          <span class="tonight-art"><img {...img(tonight.art, "120px")} alt="" class={tonight.cover ? "is-cover" : ""} /></span>
          <span class="tonight-text">
            <small>Tonight's pick</small>
            <b>{tonight.name}</b>
            <span>{tonight.sw}</span>
          </span>
          <span class="tonight-go"><Icon name="arrow" size={18} /></span>
        </a>
      </div>
      <div class="arcade-fan" aria-hidden="true">
        {fan.map((g, i) => (
          <a class={`fan-card f${i}`} href={`/games/${g.id}`} tabindex="-1">
            <img {...img(g.art, "240px")} alt="" class={g.cover ? "is-cover" : ""} />
            <span>{g.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================================================= THE GAMES -->
  <nav class="filters games-filters" aria-label="Filter games">
    <div class="wrap filters-in">
      <button type="button" class="pill" data-kind="all" aria-current="true">Zote <small>{GAMES.length}</small></button>
      {(Object.keys(KIND) as GameKind[]).map((k) => (
        <button type="button" class="pill" data-kind={k}>{KIND[k]} <small>{counts[k]}</small></button>
      ))}
    </div>
  </nav>

  <section class="wrap" style="padding:28px var(--gut) 60px">
    <div class="games-grid">
      {GAMES.map((g, i) => (
        <a class="game-card" href={`/games/${g.id}`} data-kind={g.kind} data-tilt data-reveal style={`--d:${(i % 4) * 0.06}s`}>
          <div class={`game-card-art${g.cover ? " is-cover" : ""}`}>
            <img {...img(g.art, "(max-width: 640px) 100vw, 340px")} alt="" loading={i < 4 ? "eager" : "lazy"} decoding="async" />
            <span class={`chip ${g.rewarded ? "chip-amber" : ""}`}>{g.rewarded ? `Win ${REWARD.percent}% off` : g.players ?? "Party game"}</span>
            <span class="game-kind">{KIND[g.kind]}</span>
          </div>
          <div class="game-card-body">
            <span class="card-brand">{g.sw}</span>
            <h2 class="display h3">{g.name}</h2>
            <p class="muted">{g.line}</p>
            <div class="game-meta">
              <span><Icon name="clock" size={15} /> ~{g.minutes} min</span>
              {g.teams && <span><Icon name="spark" size={15} /> Teams</span>}
              <span class="link-arrow">Cheza <span>→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- =================================================== HOW IT WORKS -->
  <section class="wrap" style="padding:0 var(--gut) 60px">
    <div class="section-head" data-reveal>
      <div>
        <span class="kicker">Game night, step by step</span>
        <h2 class="display h2">Mbogi, simu, <em>tushinde.</em></h2>
      </div>
    </div>
    <div class="steps">
      <div class="step" data-reveal><b>01</b><h3>Chagua game na mbogi</h3><p class="muted">Pick a game, then play solo or split into teams — Simba, Chui, Twiga, Ndovu. Your names are saved for next time.</p></div>
      <div class="step" data-reveal style="--d:.08s"><b>02</b><h3>Pass the phone</h3><p class="muted">Every turn has its own clock. When it runs out the phone beeps and buzzes — "Turn ya next player."</p></div>
      <div class="step" data-reveal style="--d:.16s"><b>03</b><h3>Shinda</h3><p class="muted">The scoreboard crowns a team. Playing solo? A high score in a quiz or skill game unlocks {REWARD.percent}% off.</p></div>
    </div>
  </section>

  <section class="wrap" style="padding:0 var(--gut) 140px">
    <div class="panel" style="min-height:0">
      <span class="kicker">The small print, kwa ufupi</span>
      <div class="row gap mt" style="align-items:flex-start;flex-wrap:wrap">
        <p class="muted" style="flex:1;min-width:240px;margin:0"><Icon name="spark" size={18} /> A solo high score in {GAMES.filter((g) => g.rewarded).map((g) => g.name).join(", ")} shows the code. It's saved for checkout on this device — or copy it and use it on WhatsApp.</p>
        <p class="muted" style="flex:1;min-width:240px;margin:0"><Icon name="shield" size={18} /> 18+ only. Nobody has to drink to play — water counts. One code per order, no purchase needed. <a href="/terms#games" style="text-decoration:underline">Full terms</a>.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Filters: show one kind of game, or all.
  const pills = document.querySelectorAll<HTMLButtonElement>(".games-filters [data-kind]");
  const cards = document.querySelectorAll<HTMLElement>(".games-grid .game-card");
  pills.forEach((p) =>
    p.addEventListener("click", () => {
      pills.forEach((x) => x.removeAttribute("aria-current"));
      p.setAttribute("aria-current", "true");
      const k = p.dataset.kind;
      cards.forEach((c) => {
        const show = k === "all" || c.dataset.kind === k;
        c.classList.toggle("is-hidden", !show);
        if (show) c.classList.add("in");
      });
    }),
  );

  // The floating fan leans toward the pointer.
  const arcade = document.querySelector<HTMLElement>(".arcade");
  if (arcade && matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    arcade.addEventListener("pointermove", (e) => {
      const r = arcade.getBoundingClientRect();
      arcade.style.setProperty("--px", ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
      arcade.style.setProperty("--py", ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
    });
  }
</script>
