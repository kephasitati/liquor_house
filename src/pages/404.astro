---
import Base from "../layouts/Base.astro";
---
<Base title="Not found" minorOk noindex>
  <section class="page-hero" style="min-height:80vh;display:grid;place-items:center;text-align:center">
    <div class="wrap">
      <span class="kicker">404</span>
      <h1 class="display h1">This bottle's <em>been finished.</em></h1>
      <p class="lede" style="margin:0 auto 2rem">The page you wanted isn't on the shelf. The rest of the house is.</p>
      <a class="btn btn-amber" href="/shop">Back to the shelves</a>
    </div>
  </section>
</Base>
