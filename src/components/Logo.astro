---
/**
 * The logo is the shop's own sign — see Plaque.tsx. Swap that file (and public/favicon.svg)
 * if the shop supplies artwork; nothing else draws it.
 */
import Plaque from "./Plaque";
import { site } from "../config/site";
interface Props { class?: string; id?: string }
const { class: cls = "", id = "lh" } = Astro.props;
---
<a href="/" class={`logo ${cls}`}>
  <Plaque id={id} title={site.name} />
</a>
