---
/**
 * The logo: the shop's name as its sign letters it — roman capitals in the sign's navy, "THE"
 * set small, between two thin silver rules (the sign's frame). One component for the menu bar
 * and the footer, so they can never drift apart; `size` only scales it.
 *
 * The full plaque (Plaque.tsx) still appears where a sign belongs: the age gate and the favicon.
 */
interface Props { size?: "sm" | "lg"; class?: string }
const { size = "sm", class: cls = "" } = Astro.props;
---
<a href="/" class={`logo wordmark wordmark-${size} ${cls}`}>
  <span class="wordmark-rule" aria-hidden="true"></span>
  <span class="wordmark-name"><small>The</small> Liquor House</span>
  <span class="wordmark-rule" aria-hidden="true"></span>
</a>
