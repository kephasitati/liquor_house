---
/**
 * Nairobi at night, along the bottom of the hero: a row of towers with lit windows and the
 * KICC's rotunda and saucer roughly where it stands in the real skyline. Generated from a
 * fixed seed, so it is the same on every render.
 */
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

const W = 1600, H = 160;
type B = { x: number; w: number; h: number };
const buildings: B[] = [];
let x = 0;
while (x < W) {
  const w = 30 + Math.floor(rand() * 60);
  const h = 30 + Math.floor(rand() * 90);
  buildings.push({ x, w, h });
  x += w + 2 + Math.floor(rand() * 8);
}
const windows: { x: number; y: number; d: number }[] = [];
for (const b of buildings) {
  for (let wy = H - b.h + 8; wy < H - 6; wy += 9) {
    for (let wx = b.x + 5; wx < b.x + b.w - 6; wx += 8) {
      if (rand() > 0.82) windows.push({ x: wx, y: wy, d: Math.round(rand() * 40) / 10 });
    }
  }
}
const kiccX = 880;
---
<svg class="skyline" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="sky-b" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1a1410" />
      <stop offset="1" stop-color="#0b0907" />
    </linearGradient>
  </defs>
  {buildings.map((b) => <rect x={b.x} y={H - b.h} width={b.w} height={b.h} fill="url(#sky-b)" />)}
  <!-- KICC: the rotunda, its saucer and the spire -->
  <g fill="#1d1712">
    <rect x={kiccX} y={H - 150} width="34" height="150" rx="3" />
    <ellipse cx={kiccX + 17} cy={H - 150} rx="40" ry="7" />
    <path d={`M${kiccX + 17} ${H - 175} L${kiccX + 21} ${H - 157} L${kiccX + 13} ${H - 157} Z`} />
    <rect x={kiccX - 50} y={H - 40} width="134" height="40" />
  </g>
  {windows.map((w) => <rect class="win" x={w.x} y={w.y} width="3" height="4" fill="#e8a33d" style={`animation-delay:-${w.d}s`} />)}
  {Array.from({ length: 12 }, (_, i) => <rect class="win" x={kiccX + 5 + (i % 3) * 9} y={H - 140 + Math.floor(i / 3) * 18} width="4" height="6" fill="#ffc670" style={`animation-delay:-${i * 0.7}s`} />)}
  <rect x="0" y={H - 2} width={W} height="2" fill="#e8a33d" opacity=".25" />
</svg>
