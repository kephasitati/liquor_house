---
/**
 * The hero's bottle: the house's own decanter, not a brand's — so the opening frame is
 * Liquor House, and no supplier's trademark is the face of the site. The liquid's surface
 * is a wave that drifts (two copies of one path, scrolled side by side).
 */
---
<svg viewBox="0 0 200 480" aria-label="A Liquor House decanter, lit from above" role="img">
  <defs>
    <clipPath id="hb-clip">
      <path d="M86,62 h28 v66 c0,20 58,30 58,82 v212 a22,22 0 0 1 -22,22 h-100 a22,22 0 0 1 -22,-22 v-212 c0,-52 58,-62 58,-82 z" />
    </clipPath>
    <linearGradient id="hb-liq" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7a3b0c" />
      <stop offset=".35" stop-color="#d98a2b" />
      <stop offset=".55" stop-color="#f0a845" />
      <stop offset="1" stop-color="#6a3009" />
    </linearGradient>
    <linearGradient id="hb-depth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd27a" stop-opacity=".25" />
      <stop offset="1" stop-color="#2a1203" stop-opacity=".55" />
    </linearGradient>
    <linearGradient id="hb-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".22" />
      <stop offset=".12" stop-color="#fff" stop-opacity=".05" />
      <stop offset=".8" stop-color="#000" stop-opacity=".25" />
      <stop offset="1" stop-color="#fff" stop-opacity=".1" />
    </linearGradient>
    <linearGradient id="hb-brass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7a5418" />
      <stop offset=".5" stop-color="#ffd98f" />
      <stop offset="1" stop-color="#6b4712" />
    </linearGradient>
    <linearGradient id="hb-label" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7efdd" />
      <stop offset="1" stop-color="#e3d2ad" />
    </linearGradient>
  </defs>

  <!-- empty glass -->
  <path d="M86,62 h28 v66 c0,20 58,30 58,82 v212 a22,22 0 0 1 -22,22 h-100 a22,22 0 0 1 -22,-22 v-212 c0,-52 58,-62 58,-82 z" fill="#ffffff" fill-opacity=".05" />

  <!-- liquid, with a drifting surface -->
  <g clip-path="url(#hb-clip)">
    <rect x="0" y="200" width="200" height="300" fill="url(#hb-liq)" />
    <rect x="0" y="200" width="200" height="300" fill="url(#hb-depth)" />
    <g class="hb-wave">
      <path d="M0 200 q25 -9 50 0 t50 0 t50 0 t50 0 t50 0 t50 0 t50 0 t50 0 v12 h-400 z" fill="#ffc670" fill-opacity=".75" />
    </g>
    <!-- light caustics drifting through the liquid -->
    <circle class="hb-bubble" cx="70" cy="420" r="2.2" fill="#ffe2a6" opacity=".6" />
    <circle class="hb-bubble b2" cx="120" cy="440" r="1.6" fill="#ffe2a6" opacity=".5" />
    <circle class="hb-bubble b3" cx="95" cy="450" r="1.2" fill="#ffe2a6" opacity=".5" />
  </g>

  <!-- glass over it -->
  <path d="M86,62 h28 v66 c0,20 58,30 58,82 v212 a22,22 0 0 1 -22,22 h-100 a22,22 0 0 1 -22,-22 v-212 c0,-52 58,-62 58,-82 z" fill="url(#hb-glass)" stroke="#fff" stroke-opacity=".18" stroke-width="1" />
  <path d="M42,214 q4,-30 30,-52" stroke="#fff" stroke-opacity=".5" stroke-width="4" fill="none" stroke-linecap="round" />
  <path d="M40,240 v170" stroke="#fff" stroke-opacity=".14" stroke-width="7" stroke-linecap="round" />

  <!-- stopper -->
  <rect x="82" y="50" width="36" height="16" rx="3" fill="url(#hb-brass)" />
  <rect x="88" y="22" width="24" height="30" rx="4" fill="url(#hb-brass)" />
  <circle cx="100" cy="16" r="12" fill="url(#hb-brass)" />

  <!-- label -->
  <g>
    <rect x="48" y="268" width="104" height="118" rx="4" fill="url(#hb-label)" />
    <rect x="53" y="273" width="94" height="108" rx="2.5" fill="none" stroke="#a8812f" stroke-width=".8" />
    <path d="M78 306 V292 L100 278 L122 292 V306" fill="none" stroke="#a8812f" stroke-width="1.2" stroke-linejoin="round" />
    <text x="100" y="324" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-size="14" font-weight="500" fill="#24190f">Liquor House</text>
    <text x="100" y="340" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="10" fill="#7a5a26">Reserve</text>
    <line x1="72" x2="128" y1="350" y2="350" stroke="#a8812f" stroke-width=".6" />
    <text x="100" y="364" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="5.6" letter-spacing="2" fill="#5c4524">NAIROBI · KENYA</text>
    <text x="100" y="375" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="5" letter-spacing="1.5" fill="#8a6a3a">No. 001</text>
  </g>
</svg>

<style>
  .hb-wave { animation: hbWave 5s linear infinite; }
  @keyframes hbWave { to { transform: translateX(-100px); } }
  .hb-bubble { animation: hbRise 6s ease-in infinite; }
  .hb-bubble.b2 { animation-duration: 7.5s; animation-delay: -2s; }
  .hb-bubble.b3 { animation-duration: 5s; animation-delay: -3.5s; }
  @keyframes hbRise { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: .7; } 100% { transform: translateY(-230px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hb-wave, .hb-bubble { animation: none; } }
</style>
