---
/** A drawn glass for each cocktail: the vessel, the drink inside, ice and a garnish. */
import type { Glass } from "../data/cocktails";
interface Props { glass: Glass; colour: string; garnish: string; id: string }
const { glass, colour, garnish, id } = Astro.props;
const g = id.replace(/[^a-z0-9]/gi, "");
const stroke = "rgba(244,234,215,.55)";
---
<svg viewBox="0 0 120 160" aria-hidden="true">
  <defs>
    <linearGradient id={`gl${g}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color={colour} stop-opacity=".75" />
      <stop offset=".5" stop-color={colour} />
      <stop offset="1" stop-color={colour} stop-opacity=".6" />
    </linearGradient>
    <linearGradient id={`cu${g}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7a3e1c" /><stop offset=".45" stop-color="#e59a62" /><stop offset="1" stop-color="#6a3216" />
    </linearGradient>
  </defs>
  <ellipse cx="60" cy="154" rx="34" ry="3.5" fill="#000" opacity=".5" />
  {glass === "rocks" && (
    <g>
      <path d="M26 88 H94 L90 146 H30 Z" fill={`url(#gl${g})`} opacity=".9" />
      <rect x="40" y="92" width="18" height="18" rx="3" fill="#fff" fill-opacity=".25" stroke="#fff" stroke-opacity=".5" transform="rotate(12 49 101)" />
      <rect x="60" y="100" width="16" height="16" rx="3" fill="#fff" fill-opacity=".2" stroke="#fff" stroke-opacity=".5" transform="rotate(-8 68 108)" />
      <path d="M22 70 H98 L92 150 H28 Z" fill="none" stroke={stroke} stroke-width="1.5" />
      <path d="M78 66 a14 14 0 0 1 22 8 L84 82 Z" fill={garnish} />
      <path d="M30 80 L34 140" stroke="#fff" stroke-opacity=".35" stroke-width="3" stroke-linecap="round" />
      <rect x="54" y="30" width="3" height="80" rx="1.5" fill="#d9b25a" transform="rotate(-14 55 70)" />
    </g>
  )}
  {glass === "highball" && (
    <g>
      <path d="M36 56 H84 L80 148 H40 Z" fill={`url(#gl${g})`} opacity=".85" />
      {[[48, 120, 2], [66, 100, 1.6], [56, 80, 1.3], [70, 132, 1.8], [52, 64, 1.2]].map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#fff" fill-opacity=".6" />)}
      <rect x="44" y="60" width="16" height="16" rx="3" fill="#fff" fill-opacity=".2" stroke="#fff" stroke-opacity=".45" transform="rotate(10 52 68)" />
      <path d="M34 30 H86 L80 150 H40 Z" fill="none" stroke={stroke} stroke-width="1.5" />
      <rect x="64" y="10" width="3.5" height="90" rx="1.5" fill="#e8a33d" transform="rotate(12 66 55)" />
      <circle cx="84" cy="34" r="12" fill={garnish} /><circle cx="84" cy="34" r="9" fill="none" stroke="#fff" stroke-opacity=".5" />
      <path d="M40 40 L44 140" stroke="#fff" stroke-opacity=".3" stroke-width="3" stroke-linecap="round" />
    </g>
  )}
  {glass === "coupe" && (
    <g>
      <path d="M22 58 Q60 64 98 58 Q94 92 60 94 Q26 92 22 58 Z" fill={`url(#gl${g})`} />
      <path d="M18 50 H102 Q100 96 60 98 Q20 96 18 50 Z" fill="none" stroke={stroke} stroke-width="1.5" />
      <path d="M60 98 V146 M40 150 H80" stroke={stroke} stroke-width="1.8" stroke-linecap="round" />
      <path d="M18 50 l10 -6 l10 6 l10 -6 l10 6 l10 -6 l10 6 l10 -6 l10 6 l10 -6 l2 6" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="1" />
      <path d="M86 40 a12 12 0 0 1 18 10 L88 54 Z" fill={garnish} />
    </g>
  )}
  {glass === "martini" && (
    <g>
      <path d="M26 46 H94 L60 86 Z" fill={`url(#gl${g})`} />
      <path d="M26 46 H94" stroke="#e7d2b4" stroke-width="5" stroke-linecap="round" opacity=".9" />
      <path d="M18 36 H102 L60 90 Z" fill="none" stroke={stroke} stroke-width="1.5" stroke-linejoin="round" />
      <path d="M60 90 V146 M40 150 H80" stroke={stroke} stroke-width="1.8" stroke-linecap="round" />
      {[48, 60, 72].map((x) => <ellipse cx={x} cy="43" rx="3.4" ry="2.2" fill={garnish} />)}
    </g>
  )}
  {glass === "flute" && (
    <g>
      <path d="M30 64 Q60 70 90 64 Q90 104 60 108 Q30 104 30 64 Z" fill={`url(#gl${g})`} />
      <path d="M26 30 Q22 106 60 112 Q98 106 94 30 Z" fill="none" stroke={stroke} stroke-width="1.5" />
      <path d="M60 112 V146 M40 150 H80" stroke={stroke} stroke-width="1.8" stroke-linecap="round" />
      <circle cx="74" cy="78" r="13" fill={garnish} opacity=".9" /><circle cx="74" cy="78" r="10" fill="none" stroke="#fff" stroke-opacity=".5" />
      {[[46, 90], [56, 80], [50, 72]].map(([x, y]) => <circle cx={x} cy={y} r="1.5" fill="#fff" fill-opacity=".7" />)}
    </g>
  )}
  {glass === "mug" && (
    <g>
      <path d="M28 52 H86 L84 146 Q84 150 80 150 H34 Q30 150 30 146 Z" fill={`url(#cu${g})`} />
      <path d="M86 70 Q106 72 104 98 Q102 120 84 122" fill="none" stroke={`url(#cu${g})`} stroke-width="7" stroke-linecap="round" />
      <path d="M36 60 L38 140" stroke="#fff" stroke-opacity=".35" stroke-width="4" stroke-linecap="round" />
      <ellipse cx="57" cy="52" rx="29" ry="5" fill={colour} />
      <path d="M52 48 q-6 -18 4 -26 q2 12 10 14" fill={garnish} />
      <circle cx="74" cy="46" r="9" fill="#cddc39" /><circle cx="74" cy="46" r="6.5" fill="none" stroke="#fff" stroke-opacity=".5" />
    </g>
  )}
</svg>
